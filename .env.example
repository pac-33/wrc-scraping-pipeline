# Copy to .env and adjust. Never commit .env.

# --- docker compose service credentials ---------------------------------------
MONGO_INITDB_ROOT_USERNAME=wrc_root
MONGO_INITDB_ROOT_PASSWORD=change-me
MINIO_ROOT_USER=wrc_minio_root
MINIO_ROOT_PASSWORD=change-me-too

# --- application settings (pydantic-settings, prefix WRC_, nesting via __) ----
WRC_LOG_LEVEL=INFO
WRC_LOG_FORMAT=json

WRC_MONGO__URI=mongodb://wrc_root:change-me@localhost:27017
WRC_MONGO__DATABASE=wrc

WRC_OBJECT_STORE__ENDPOINT_URL=http://localhost:9000
WRC_OBJECT_STORE__ACCESS_KEY=wrc_minio_root
WRC_OBJECT_STORE__SECRET_KEY=change-me-too
WRC_OBJECT_STORE__LANDING_BUCKET=wrc-landing
WRC_OBJECT_STORE__CURATED_BUCKET=wrc-curated

# Identifies the scraper to the site operator (goes into the User-Agent).
WRC_SCRAPER__CONTACT_EMAIL=you@example.com

# Optional tuning (defaults shown):
# WRC_SCRAPER__BODIES=[1,2,3,15376]
# WRC_SCRAPER__PARTITION_SIZE=monthly
# WRC_SCRAPER__TARGET_CONCURRENCY=2.0
# WRC_SCRAPER__RETRY_TIMES=3
# WRC_SCRAPER__FETCH_ROBOTS_DISALLOWED_DOCUMENTS=true
# WRC_SCRAPER__DEV_HTTP_CACHE=false
